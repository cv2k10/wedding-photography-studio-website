{
  "name": "wedding-photography-studio-website",
  "private": true,
  "scripts": {
    "css": "tailwindcss -i src/styles.css -o public/styles.css --minify",
    "dev": "npm run css && wrangler dev --ip 0.0.0.0",
    "build": "npm run css && wrangler deploy --dry-run --outdir dist",
    "deploy": "npm run css && wrangler deploy",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "seed:local": "wrangler d1 execute DB --local --file seeds/demo.sql",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "seed:generate": "tsx scripts/generate-seed.ts",
    "db:generate": "drizzle-kit generate --dialect sqlite --schema ./src/db/schema.ts --out migrations"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261120.1",
    "@tailwindcss/cli": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "wrangler": "^4.165.0"
  }
}
